# Browser-visible values. Vite variables are public and must never contain secrets.
VITE_API_BASE_URL=/api
# Development fallback only; production builds must configure a production-safe provider.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_PUBLIC_PARAMETER=
