# Database is optional for local fixture tests but required when metadata is
# served from PostgreSQL/PostGIS.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geosnap
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:change-me@db:5432/geosnap

# Required for live Mapillary ingestion. Never commit a real token.
MAPILLARY_ACCESS_TOKEN=

# Artifact and model configuration.
DATA_ROOT=data
GEOSNAP_MODEL_CACHE=.cache/torch/hub
HF_HOME=.cache/huggingface
GEOSNAP_LOCALIZATION_FACTORY=ml.localization.service:create_localization_service
RETRIEVER=megaloc
TORCH_DEVICE=auto
CITY_ID=moscow
INDEX_ID=moscow
REFERENCE_MANIFEST=data/processed/manifest_clean.parquet
GEOSNAP_INDEX_DIR=data/indexes/moscow/megaloc
FAISS_PROCESS_ISOLATION=auto
EMBEDDING_BATCH_SIZE=8
RETRIEVAL_TOP_K=20
VERIFY_TOP_K=10
VERIFICATION_ENABLED=false
VERIFICATION_BACKEND=opencv_sift
VERIFICATION_GEOMETRIC_WEIGHT=0.35
CONFIDENCE_THRESHOLD=0.55
OOC_SIMILARITY_THRESHOLD=0.15
CONFIDENT_SIMILARITY_THRESHOLD=0.65
MINIMUM_CLUSTER_MASS=0.45
MINIMUM_CLUSTER_MASS_MARGIN=0.10
MINIMUM_CLUSTER_CANDIDATES=2
GOOD_GEOGRAPHIC_MARGIN=0.08
GOOD_HYPOTHESIS_SEPARATION_M=500
LOCALIZATION_CLUSTER_RADIUS_M=100
LOCALIZATION_MAX_CLUSTER_DIAMETER_M=150
COORDINATE_ESTIMATOR=weighted_medoid

# Upload safety limits.
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=12000
MULTIPART_OVERHEAD_BYTES=262144
LOCALIZATION_CONCURRENCY=2
READINESS_CHECK_DATABASE=false

# Browser demo origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
