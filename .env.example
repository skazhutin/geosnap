# GeoSnap production deployment. Copy to .env and fill the required public map
# values and Telegram secret before starting production services.

# Public endpoint. Keep http/localhost/8080 for a local smoke. For a real
# deployment use https, the real DNS name, and host ports 80/443.
GEOSNAP_SCHEME=http
GEOSNAP_DOMAIN=localhost
GEOSNAP_HTTP_PORT=8080
GEOSNAP_HTTPS_PORT=8443
GEOSNAP_APP_VERSION=local

# Persistent in-container artifact root. The production Compose named volume is
# mounted here; normal backend requests have no artifact-network dependency.
GEOSNAP_ARTIFACT_DIR=/var/lib/geosnap/artifacts

# Required production-safe browser tile provider. VITE/MAP values are public;
# never put a server-side secret in them. MAP_TILE_ORIGIN is scheme + host only
# and is used by the Content Security Policy.
MAP_TILE_URL=
MAP_TILE_ORIGIN=
MAP_ATTRIBUTION=
MAP_TILE_PUBLIC_PARAMETER=

# Backend operational controls. Frozen model/index/policy values are not
# environment-configurable.
BACKEND_CPU_THREADS=4
LOCALIZATION_CONCURRENCY=1
LOCALIZATION_QUEUE_LIMIT=2
LOCALIZATION_QUEUE_TIMEOUT_SECONDS=5
LOCALIZATION_TIMEOUT_SECONDS=30
LOCALIZATION_RATE_PER_MINUTE=12
LOCALIZATION_RATE_BURST=3
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=10000
MULTIPART_OVERHEAD_BYTES=262144
UPLOAD_TIMEOUT_SECONDS=15
PROXY_MAX_REQUEST_BYTES=11000000
PROXY_BACKEND_TIMEOUT=35s
LOG_LEVEL=INFO
METRICS_ENABLED=true

# Telegram bot secret and operational limits. Leave TELEGRAM_VALIDATE_ONLY=true
# only for a configuration smoke that must not contact Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_VALIDATE_ONLY=false
TELEGRAM_USER_COOLDOWN_SECONDS=8
TELEGRAM_MAX_CONCURRENCY=2
TELEGRAM_MAX_DOWNLOAD_BYTES=10485760
TELEGRAM_BACKEND_TIMEOUT_SECONDS=30

# Development/offline-data-only values; unused by the production Compose ML
# contract. MAPILLARY_ACCESS_TOKEN is needed only for new ingestion research.
MAPILLARY_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
